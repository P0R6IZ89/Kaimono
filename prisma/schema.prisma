generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Status {
  PENDING
  PURCHASED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique @db.Citext
  name            String?
  image           String?
  emailVerified   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  Authenticator   Authenticator[]
  memberships     Membership[]
  invitationsSent Invitation[]     @relation("InvitationSender")
  essentials      Essential[]
  planneds        Planned[]
  plannedComments PlannedComment[]
  plannedLikes    PlannedLike[]
  Project         Project[]
}

model App {
  id          String       @id @default(cuid())
  name        String
  description String?
  subdomain   String       @unique
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  projects    Project[]
  invitations Invitation[]
  essentials  Essential[]
  planneds    Planned[]
}

// Junction table for APP ⇆ User
model Membership {
  id       String   @id @default(cuid())
  appId    String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
}

// Holds pending & historic invitations
model Invitation {
  id                 String           @id @default(cuid())
  appId              String
  email              String           @db.Citext
  token              String           @unique
  role               Role             @default(MEMBER)
  inviterId          String
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  acceptedAt         DateTime?
  revokedAt          DateTime?
  lastStatusUpdateAt DateTime         @default(now())

  app     App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([appId, email])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Project {
  id           String    @id @default(cuid())
  name         String
  description  String?
  creatorId    String?
  creator      User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  plannedItems Planned[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  App          App?      @relation(fields: [appId], references: [id])
  appId        String?
}

model Essential {
  id        String   @id @default(cuid())
  title     String
  price     Decimal  @default(0) @db.Decimal(12, 2)
  status    Status   @default(PENDING)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  creatorId String?
  creator   User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([appId, status, createdAt])
}

model Planned {
  id          String   @id @default(cuid())
  title       String
  price       Decimal  @default(0) @db.Decimal(12, 2)
  priority    Priority
  status      Status   @default(PENDING)
  quantity    Int      @default(1)
  image       String?
  productUrl  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  creatorId   String?
  creator     User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  comments PlannedComment[]
  likes    PlannedLike[]

  @@index([creatorId, createdAt])
  @@index([appId, projectId])
}

model PlannedComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  plannedId String
  planned   Planned  @relation(fields: [plannedId], references: [id], onDelete: Cascade)
}

model PlannedLike {
  id        String   @id @default(cuid())
  liked     Boolean  @default(false)
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [creatorId], references: [id])
  creatorId String
  planned   Planned  @relation(fields: [plannedId], references: [id], onDelete: Cascade)
  plannedId String

  @@unique([creatorId, plannedId])
}
